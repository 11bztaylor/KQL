  "TRAFFIC_allow_10.1", datetime(2026-06-18T19:51:32Z), "fw-edge-02",
    "0|Palo Alto Networks|PAN-OS|10.1.10-i11|end|TRAFFIC|1|rt=Jun 18 2026 19:51:32 GMT deviceExternalId=012345678902 src=10.20.30.55 dst=23.50.60.70 sourceTranslatedAddress=198.51.100.10 destinationTranslatedAddress=23.50.60.70 cs1Label=Rule cs1=Allow-Outbound-Web suser=jdoe@contoso.com duser= app=ssl cs4Label=Source Zone cs4=trust cs5Label=Destination Zone cs5=untrust deviceInboundInterface=ae7 deviceOutboundInterface=ae3 cs6Label=LogProfile cs6=Net-LogProfile-01 cn1Label=SessionID cn1=2546623 cnt=1 spt=54655 dpt=443 sourceTranslatedPort=54902 destinationTranslatedPort=443 flexString1Label=Flags flexString1=0x54340d proto=tcp act=allow flexNumber1Label=Total bytes flexNumber1=2080 in=60 out=2020 cn2Label=Packets cn2=4 PanOSPacketsReceived=1 PanOSPacketsSent=4 start=Jun 18 2026 19:51:32 GMT cn3Label=Elapsed time in seconds cn3=0 cs2Label=URL Category cs2=web-advertisements externalId=7239847239901 reason=aged-out dvchost=fw-edge-02 cat=from-policy PanOSSCTPAssocID=0 PanOSSCTPChunks=0 PanOSSCTPChunkSent=0 PanOSSCTPChunksRcv=0 PanOSRuleUUID=c3f0d2b5-6a4e-4d9f-8b2c-3e4f5a6b7c8d PanOSHTTP2Con=0 PanLinkChange=0 PanPolicyID= PanLinkDetail= PanSDWANCluster= PanSDWANDevice= PanSDWANClustype= PanSDWANSite= PanSrcEDL= PanDstEDL= PanGPHostID= PanSrcDAG= PanDstDAG= PanHASessionOwner=",
  "THREAT_url_10.1", datetime(2026-06-18T20:02:34Z), "fw-edge-02",
    "0|Palo Alto Networks|PAN-OS|10.1.10-h10|url|THREAT|1|rt=Jun 18 2026 20:02:34 GMT deviceExternalId=012345678903 src=10.20.30.77 dst=20.190.160.10 sourceTranslatedAddress=198.51.100.20 destinationTranslatedAddress=20.190.160.10 cs1Label=Rule cs1=Outbound-URL-Inspect suser=asmith@contoso.com duser= app=ssl cs4Label=Source Zone cs4=trust cs5Label=Destination Zone cs5=untrust deviceInboundInterface=ae7 deviceOutboundInterface=ae1 cs6Label=LogProfile cs6=Threat-LogProfile-01 cn1Label=SessionID cn1=500741 cnt=1 spt=65171 dpt=443 sourceTranslatedPort=36856 destinationTranslatedPort=443 flexString1Label=Flags flexString1=0x1a2b3c proto=tcp act=alert request=\"mobile.events.data.microsoft.com/\" cs2Label=URL Category cs2=computer-and-internet-info flexString2Label=Direction flexString2=client-to-server externalId=7239847240015 requestContext= cat=(9999) fileId=0 requestMethod= requestClientApplication= dvchost=fw-edge-02 PanOSHTTPHeader= PanOSRuleUUID=d4a1e3c6-7b5f-4e0a-9c3d-4f5a6b7c8d9e PanOSURLCatList=\"SharedDocDefenderUrl,computer-and-internet-info,low-risk\" PanOSHTTP2Con=0 PanDynamicUsrgrp=",
