  // NEGATIVE: a non-Palo-Alto CEF row -- the parser MUST drop this.
  "NEGATIVE_cisco_asa", datetime(2026-06-18T21:10:00Z), "asa-1",
    "CEF:0|Cisco|ASA|9.1|106023|Deny protocol src|3|src=10.0.0.1 dst=10.0.0.2 spt=1234 dpt=443 act=Deny"
];
//
let Expected = datatable(TestName:string, ExpLogType:string, ExpSubType:string, ExpVersion:string, ExpDPt:int, ExpAction:string, ExpRule:string, ExpUrlCat:string, ExpSession:long, ExpRequest:string, ExpDirection:string)
[
  "TRAFFIC_drop_13.5",  "TRAFFIC", "drop", "13.5.60-h10", 7680, "drop",  "Deny-Inbound-Default", "any",                        0,       "",                                  "",
  "TRAFFIC_allow_10.1", "TRAFFIC", "end",  "10.1.10-i11", 443,  "allow", "Allow-Outbound-Web",   "web-advertisements",         2546623, "",                                  "",
  "THREAT_url_10.1",    "THREAT",  "url",  "10.1.10-h10", 443,  "alert", "Outbound-URL-Inspect", "computer-and-internet-info", 500741,  "mobile.events.data.microsoft.com/", "client-to-server",
  "USERID_login_10.1",  "USERID",  "login","10.1.11-h5",  0,    "",      "",                     "",                           1,       "",                                  ""
];
//
// --- A) FIELD ASSERTIONS against the REAL parser ------------------------------------
PaloAlto_CEF_ParseRows(FakeSyslog)
| project
    TestName,
    LogType, SubType, DeviceVendor, DeviceProduct, DeviceVersion,
    DestinationPort = toint(['dpt']),
    DeviceAction    = tostring(['act']),
    RuleName        = tostring(['cs1']),
    URLCategory     = tostring(['cs2']),
    SessionID       = toint(['cn1']),
    RequestURL      = trim('"', tostring(['request'])),
    Direction       = tostring(['flexString2'])
| join kind=inner Expected on TestName
| extend Details = strcat(
    iff(LogType         == ExpLogType,           "", "LogType "),
    iff(SubType         == ExpSubType,           "", "SubType "),
    iff(DeviceVendor    == "Palo Alto Networks", "", "Vendor "),
    iff(DeviceProduct   == "PAN-OS",             "", "Product "),
    iff(DeviceVersion   == ExpVersion,           "", "Version "),
    iff(DestinationPort == ExpDPt,               "", "DestPort "),
    iff(DeviceAction    == ExpAction,            "", "Action "),
    iff(RuleName        == ExpRule,              "", "RuleName "),
    iff(URLCategory     == ExpUrlCat,            "", "URLCategory "),
    iff(SessionID       == ExpSession,           "", "SessionID "),
    iff(RequestURL      == ExpRequest,           "", "RequestURL "),
    iff(Direction       == ExpDirection,         "", "Direction ")
  )
| extend Passed = isempty(Details)
| project TestName, Passed, Details, LogType, SubType, DeviceVersion, DestinationPort,
          DeviceAction, RuleName, URLCategory, SessionID, RequestURL, Direction
| order by TestName asc;
//
// --- B) INVARIANT: non-Palo-Alto rows are dropped; exactly the 4 PA rows survive -----
PaloAlto_CEF_ParseRows(FakeSyslog)
| summarize ParsedRows = count(), DistinctTypes = dcount(LogType)
| extend
    InputRows         = toscalar(FakeSyslog | count),
    NonPaloAltoInput  = toscalar(FakeSyslog | where SyslogMessage !has "Palo Alto Networks" | count)
| extend Passed = (ParsedRows == 4 and DistinctTypes == 3 and NonPaloAltoInput == 1)
| project Test = "non-PA excluded; 4 PA rows across 3 log types survive", Passed,
          InputRows, ParsedRows, NonPaloAltoInput, DistinctTypes;
