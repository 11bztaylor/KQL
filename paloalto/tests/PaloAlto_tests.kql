// =====================================================================================
// PaloAlto_tests.kql  --  parser characterization tests
// =====================================================================================
// WHAT THIS IS / WHY IT LOOKS THIS WAY
//   The production parser (PaloAlto_CEF_Parsed) is a PURE function that reads the Syslog
//   table directly -- the standard ADX update-policy pattern. A pure parser can't be handed
//   synthetic rows, so this file is a *characterization test*: it mirrors the deployed
//   ROUTING + HEADER parse exactly on sample messages and spot-checks field extraction.
//
//   It is intentionally minimal-overlap with production: it reproduces only the routing
//   filter, the '|' header split, and a small NON-greedy parse-kv for the handful of fields
//   it asserts (single-token values, so no need to mirror the full greedy key schema).
//   If you change the header layout or routing in PaloAlto_CEF.kql, update the mirror below.
//
//   FULL-FIDELITY OPTION (true end-to-end): in a scratch database, deploy PaloAlto_CEF.kql,
//   then `.set-or-append Syslog` with these sample messages and query the real PaloAlto_*
//   tables. See docs/TESTING.md. (Don't do that on a prod DB -- it triggers the update
//   policies and routes the test rows into the real tables.)
//
//   Sample values are FAKE but representative (RFC 5737/1918 IPs, example users).
//
// RESULTS (two tables)
//   A) Field assertions  -- every row Passed == true, Details empty.
//   B) Invariant check   -- the non-Palo-Alto (Cisco) row is dropped; the 4 PA rows survive.
// =====================================================================================

let FakeSyslog = datatable(TimeGenerated:datetime, Computer:string, SyslogMessage:string)
[
  datetime(2026-06-15T14:58:03Z), "fw-edge-01",
    "0|Palo Alto Networks|PAN-OS|13.5.60-h10|drop|TRAFFIC|1|rt=Jun 15 2026 14:58:03 GMT deviceExternalId=012345678901 src=10.20.30.40 dst=203.0.113.45 cs1Label=Rule cs1=Deny-Inbound-Default app=not-applicable cn1Label=SessionID cn1=0 spt=50234 dpt=7680 flexString1Label=Flags flexString1=0x0 proto=tcp act=drop cs2Label=URL Category cs2=any externalId=7239847239847 reason=policy-deny dvchost=fw-edge-01 cat=from-policy PanOSRuleUUID=b2e9c1a4-5f3d-4c8e-9a1b-2d3e4f5a6b7c",
  datetime(2026-06-18T19:51:32Z), "fw-edge-02",
    "0|Palo Alto Networks|PAN-OS|10.1.10-i11|end|TRAFFIC|1|rt=Jun 18 2026 19:51:32 GMT deviceExternalId=012345678902 src=10.20.30.55 dst=23.50.60.70 cs1Label=Rule cs1=Allow-Outbound-Web suser=jdoe@contoso.com app=ssl cn1Label=SessionID cn1=2546623 spt=54655 dpt=443 flexString1Label=Flags flexString1=0x54340d proto=tcp act=allow cs2Label=URL Category cs2=web-advertisements externalId=7239847239901 reason=aged-out dvchost=fw-edge-02 cat=from-policy PanOSRuleUUID=c3f0d2b5-6a4e-4d9f-8b2c-3e4f5a6b7c8d",
  datetime(2026-06-18T20:02:34Z), "fw-edge-02",
    "0|Palo Alto Networks|PAN-OS|10.1.10-h10|url|THREAT|1|rt=Jun 18 2026 20:02:34 GMT deviceExternalId=012345678903 src=10.20.30.77 dst=20.190.160.10 cs1Label=Rule cs1=Outbound-URL-Inspect suser=asmith@contoso.com app=ssl spt=65171 dpt=443 flexString1Label=Flags flexString1=0x1a2b3c proto=tcp act=alert request=mobile.events.data.microsoft.com/ cs2Label=URL Category cs2=computer-and-internet-info flexString2Label=Direction flexString2=client-to-server externalId=7239847240015 cat=(9999) cn1Label=SessionID cn1=500741 dvchost=fw-edge-02 PanOSRuleUUID=d4a1e3c6-7b5f-4e0a-9c3d-4f5a6b7c8d9e",
  datetime(2026-06-18T21:06:10Z), "fw-edge-02",
    "0|Palo Alto Networks|PAN-OS|10.1.11-h5|login|USERID|1|rt=Jun 18 2026 21:06:10 GMT deviceExternalId=012345678904 cs4Label=Data Source Name cs4=AD-Agent-01 cn1Label=Factor Number cn1=1 src=10.20.30.88 spt=0 dpt=0 duser=jdoe@contoso.com externalId=7239847240120 cat=0 dvchost=fw-edge-02 PanOSActionFlags=0x8000000000000000 PanOSUserBySource=contoso\\jdoe",
  // NEGATIVE: a non-Palo-Alto CEF row -- routing MUST drop this.
  datetime(2026-06-18T21:10:00Z), "asa-1",
    "CEF:0|Cisco|ASA|9.1|106023|Deny protocol src|3|src=10.0.0.1 dst=10.0.0.2 spt=1234 dpt=443 act=Deny"
];
//
// Mirror of the production routing + header parse (PaloAlto_CEF_Parsed), then a minimal
// non-greedy parse-kv for the asserted single-token fields.
let Parsed =
    FakeSyslog
    | where SyslogMessage has "Palo Alto Networks"
    | extend _p = split(SyslogMessage, '|')
    | where tostring(_p[1]) == "Palo Alto Networks"
    | extend
        DeviceVendor  = tostring(_p[1]),
        DeviceProduct = tostring(_p[2]),
        DeviceVersion = tostring(_p[3]),
        SubType       = tostring(_p[4]),
        LogType       = toupper(tostring(_p[5]))
    | extend _ext = strcat_array(array_slice(_p, 7, -1), '|')
    | parse-kv _ext as (dpt:int, act:string, src:string, dst:string, cs1:string, cs2:string, cn1:int, request:string, flexString2:string)
        with (pair_delimiter = ' ', kv_delimiter = '=');
//
let Expected = datatable(DeviceVersion:string, ExpLogType:string, ExpSubType:string, ExpDPt:int, ExpAction:string, ExpRule:string, ExpUrlCat:string, ExpSession:long, ExpRequest:string, ExpDirection:string)
[
  "13.5.60-h10", "TRAFFIC", "drop",  7680, "drop",  "Deny-Inbound-Default", "any",                        0,       "",                                  "",
  "10.1.10-i11", "TRAFFIC", "end",   443,  "allow", "Allow-Outbound-Web",   "web-advertisements",         2546623, "",                                  "",
  "10.1.10-h10", "THREAT",  "url",   443,  "alert", "Outbound-URL-Inspect", "computer-and-internet-info", 500741,  "mobile.events.data.microsoft.com/", "client-to-server",
  "10.1.11-h5",  "USERID",  "login", 0,    "",      "",                     "",                           1,       "",                                  ""
];
//
// --- A) FIELD ASSERTIONS -------------------------------------------------------------
Parsed
| project DeviceVersion, LogType, SubType, DeviceVendor, DeviceProduct,
    DestinationPort = toint(dpt), DeviceAction = tostring(act), RuleName = tostring(cs1),
    URLCategory = tostring(cs2), SessionID = toint(cn1),
    RequestURL = trim('"', tostring(request)), Direction = tostring(flexString2)
| join kind=inner Expected on DeviceVersion
| extend Details = strcat(
    iff(LogType         == ExpLogType,           "", "LogType "),
    iff(SubType         == ExpSubType,           "", "SubType "),
    iff(DeviceVendor    == "Palo Alto Networks", "", "Vendor "),
    iff(DeviceProduct   == "PAN-OS",             "", "Product "),
    iff(DestinationPort == ExpDPt,               "", "DestPort "),
    iff(DeviceAction    == ExpAction,            "", "Action "),
    iff(RuleName        == ExpRule,              "", "RuleName "),
    iff(URLCategory     == ExpUrlCat,            "", "URLCategory "),
    iff(SessionID       == ExpSession,           "", "SessionID "),
    iff(RequestURL      == ExpRequest,           "", "RequestURL "),
    iff(Direction       == ExpDirection,         "", "Direction ")
  )
| extend Passed = isempty(Details)
| project DeviceVersion, LogType, SubType, Passed, Details, DestinationPort, DeviceAction,
          RuleName, URLCategory, SessionID, RequestURL, Direction
| order by DeviceVersion asc;
//
// --- B) INVARIANT: routing drops the non-Palo-Alto row -------------------------------
Parsed
| summarize ParsedRows = count(), DistinctTypes = dcount(LogType)
| extend
    InputRows        = toscalar(FakeSyslog | count),
    NonPaloAltoInput = toscalar(FakeSyslog | where SyslogMessage !has "Palo Alto Networks" | count)
| extend Passed = (ParsedRows == 4 and DistinctTypes == 3 and NonPaloAltoInput == 1)
| project Test = "non-PA excluded; 4 PA rows across 3 log types survive", Passed,
          InputRows, ParsedRows, NonPaloAltoInput, DistinctTypes;
